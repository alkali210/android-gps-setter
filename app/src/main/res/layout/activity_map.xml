<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="24dp"
            android:elevation="1dp"
            app:navigationIcon="@drawable/ic_baseline_menu_24"
            app:navigationIconTint="@color/glass_ink"/>

        <include
            android:id="@+id/search"
            layout="@layout/include_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="18dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="72dp"
            android:gravity="center_vertical"
            android:lines="1"
            android:padding="8dp"
            android:paddingStart="8dp"
            android:textSize="18sp"
        />

        <include
            android:id="@+id/map_container"
            layout="@layout/map_container"
            android:layout_height="match_parent"
            android:layout_width="match_parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getlocation"
            style="@style/GlassFab"
            android:contentDescription="@string/getlocation_desc"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_above="@id/route_panel"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.95"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_baseline_my_location_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" />
            <!-- app:backgroundTint="@color/background" -->
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addfavorite"
            style="@style/GlassFab"
            android:contentDescription="@string/addfavorite_desc"
            android:layout_above="@id/getlocation"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="16dp"
            android:alpha="0.95"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_baseline_favorite"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_button"
            android:contentDescription="@string/location_set"
            style="@style/GlassFab"
            android:layout_above="@id/addfavorite"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="0.95"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play"
            app:iconTint="?attr/colorPrimary"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"

            android:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop_button"
             android:contentDescription="@string/location_unset"
            style="@style/GlassFab"
            android:layout_above="@id/addfavorite"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:alpha="0.95"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" 

            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/gpx_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_box_background"
            android:elevation="10dp"
            android:padding="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gpx_speed_minus"
                style="@style/SpeedStepper"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/route_speed_decrease"
                android:text="−" />

            <TextView
                android:id="@+id/gpx_speed_value"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/glass_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite"
                tools:text="50 km/h" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gpx_speed_plus"
                style="@style/SpeedStepper"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/route_speed_increase"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/route_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:background="@drawable/search_box_background"
            android:padding="14dp"
            android:elevation="10dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_static"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_static" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_route"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_route" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/route_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

                <!-- SETUP: choose A/B, speed, start -->
                <LinearLayout
                    android:id="@+id/route_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/directions" android:textColor="@color/glass_ink" android:textSize="19sp" android:textStyle="bold"/>
                        <ImageButton android:id="@+id/route_swap" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_swap" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_swap"/>
                        <ImageButton android:id="@+id/route_cancel" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_cancel"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/dot_a"/>
                        <TextView android:id="@+id/route_a_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textColor="@color/glass_ink" android:textSize="15sp" android:text="@string/route_pick_a"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/glass_stroke"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/dot_b"/>
                        <TextView android:id="@+id/route_b_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textColor="@color/glass_ink_dim" android:textSize="15sp" android:text="@string/route_b_placeholder"/>
                    </LinearLayout>

                    <TextView android:id="@+id/route_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/glass_ink_dim" android:textSize="12sp" android:text="@string/route_edit_hint"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="14dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:text="@string/route_speed"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/speed_minus" style="@style/SpeedStepper" android:layout_width="44dp" android:layout_height="44dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="−"/>
                        <TextView android:id="@+id/speed_value" android:layout_width="92dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/glass_ink" android:textStyle="bold" tools:text="50 km/h"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/speed_plus" style="@style/SpeedStepper" android:layout_width="44dp" android:layout_height="44dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="+"/>
                    </LinearLayout>

                    <TextView android:id="@+id/route_summary_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/glass_ink_dim" android:textSize="12.5sp" android:visibility="gone" tools:text="2.1 km · about 7 min"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/route_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:enabled="false" app:icon="@drawable/ic_play" android:text="@string/route_start"/>
                </LinearLayout>

                <!-- TRAVELLING: progress + stats -->
                <LinearLayout
                    android:id="@+id/route_travel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/route_travelling" android:textColor="@color/glass_ink" android:textSize="19sp" android:textStyle="bold"/>
                        <ImageButton android:id="@+id/travel_expand" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_play" android:rotation="270" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_details"/>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/travel_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" app:trackCornerRadius="3dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/travel_dist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="0.9 km"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_travelled"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/travel_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="50 km/h"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_speed"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:id="@+id/travel_eta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="4:10"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_arrival"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:id="@+id/travel_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/glass_ink_dim" android:textSize="13sp" android:visibility="gone" tools:text="A  Srinivasa Nagar\nB  Chaitanya Nagar"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/route_stop" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:icon="@drawable/ic_stop" android:text="@string/stop_route"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/main_menu">
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>