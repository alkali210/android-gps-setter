<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav shell: Teleport and Routes share the map; Saved and Targets are opaque screens drawn over it. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/TacticalBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav" />

    <RelativeLayout
        android:id="@+id/map_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav">

        <include
            android:id="@+id/map_container"
            layout="@layout/map_container"
            android:layout_height="match_parent"
            android:layout_width="match_parent"/>

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/search"
                layout="@layout/include_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                style="@style/GlassFab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/settings"
                android:elevation="8dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_outline_settings_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getlocation"
            style="@style/GlassFab"
            android:contentDescription="@string/getlocation_desc"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_above="@id/bottom_panels"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_baseline_my_location_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addfavorite"
            style="@style/GlassFab"
            android:contentDescription="@string/addfavorite_desc"
            android:layout_above="@id/getlocation"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_baseline_favorite"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp" />

        <!-- Teleport tab: D-pad nudges the selected point (and the live one while spoofing) -->
        <LinearLayout
            android:id="@+id/dpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_panels"
            android:layout_alignParentStart="true"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/search_box_background"
            android:elevation="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageButton android:id="@+id/nudge_n" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nudge_north" android:src="@drawable/ic_chevron" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton android:id="@+id/nudge_w" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nudge_west" android:rotation="-90" android:src="@drawable/ic_chevron" />
                <TextView android:id="@+id/nudge_step" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nudge_step_desc" android:fontFamily="monospace" android:gravity="center" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold" tools:text="5 m" />
                <ImageButton android:id="@+id/nudge_e" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nudge_east" android:rotation="90" android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <ImageButton android:id="@+id/nudge_s" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nudge_south" android:rotation="180" android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <!-- one of the two panels shows, per tab; the FABs and D-pad sit above whichever it is -->
        <LinearLayout
            android:id="@+id/bottom_panels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

        <!-- Teleport tab: telemetry + start/stop -->
        <LinearLayout
            android:id="@+id/teleport_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_box_background"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:id="@+id/spoof_dot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/status_dot" />
                <TextView android:id="@+id/spoof_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:fontFamily="monospace" android:textColor="@color/glass_ink_dim" android:textSize="12sp" tools:text="Live · accuracy 10 m" />
                <ImageButton android:id="@+id/copy_coords" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/copy_coords" android:src="@drawable/ic_copy" />
            </LinearLayout>

            <TextView android:id="@+id/coords" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/glass_ink" android:textSize="20sp" android:textStyle="bold" tools:text="17.361610, 78.474660" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/jitter" android:textColor="@color/glass_ink_dim" android:textSize="13sp" />
                <com.google.android.material.slider.Slider android:id="@+id/jitter_slider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:contentDescription="@string/jitter" android:stepSize="0.5" android:valueFrom="0" android:valueTo="25" app:labelBehavior="gone" app:tickVisible="false" />
                <TextView android:id="@+id/jitter_value" android:layout_width="64dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:gravity="end" android:textColor="@color/glass_ink" android:textSize="13sp" tools:text="±1.5 m" />
            </LinearLayout>

            <!-- the divider spaces the buttons only when both show (Move here + Stop) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:divider="@drawable/space_8" android:orientation="horizontal" android:showDividers="middle">
                <com.google.android.material.button.MaterialButton android:id="@+id/start_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/start_mock" app:icon="@drawable/ic_play" />
                <com.google.android.material.button.MaterialButton android:id="@+id/stop_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/stop" android:visibility="gone" app:icon="@drawable/ic_stop" />
            </LinearLayout>
        </LinearLayout>

        <!-- Routes tab: A->B setup, then progress while travelling -->
        <LinearLayout
            android:id="@+id/route_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/search_box_background"
            android:padding="14dp"
            android:elevation="10dp"
            android:visibility="gone">

            <!-- SETUP: choose A/B, speed, start -->
            <LinearLayout
                android:id="@+id/route_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/directions" android:textColor="@color/glass_ink" android:textSize="19sp" android:textStyle="bold"/>
                    <ImageButton android:id="@+id/route_swap" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_swap" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_swap"/>
                    <ImageButton android:id="@+id/route_cancel" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_cancel"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/dot_a"/>
                    <TextView android:id="@+id/route_a_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textColor="@color/glass_ink" android:textSize="15sp" android:text="@string/route_pick_a"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/glass_stroke"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/dot_b"/>
                    <TextView android:id="@+id/route_b_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textColor="@color/glass_ink_dim" android:textSize="15sp" android:text="@string/route_b_placeholder"/>
                </LinearLayout>

                <TextView android:id="@+id/route_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/glass_ink_dim" android:textSize="12sp" android:text="@string/route_edit_hint"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="14dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:text="@string/route_speed"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/speed_minus" style="@style/SpeedStepper" android:layout_width="44dp" android:layout_height="44dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="−"/>
                    <TextView android:id="@+id/speed_value" android:layout_width="92dp" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="monospace" android:textColor="@color/glass_ink" android:textStyle="bold" tools:text="50 km/h"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/speed_plus" style="@style/SpeedStepper" android:layout_width="44dp" android:layout_height="44dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="+"/>
                </LinearLayout>

                <TextView android:id="@+id/route_summary_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:fontFamily="monospace" android:textColor="@color/glass_ink_dim" android:textSize="12.5sp" android:visibility="gone" tools:text="2.1 km · about 7 min"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/route_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:enabled="false" app:icon="@drawable/ic_play" android:text="@string/route_start"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/route_gpx" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/play_route"/>
            </LinearLayout>

            <!-- TRAVELLING: progress + stats -->
            <LinearLayout
                android:id="@+id/route_travel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/route_travelling" android:textColor="@color/glass_ink" android:textSize="19sp" android:textStyle="bold"/>
                    <ImageButton android:id="@+id/travel_expand" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_play" android:rotation="270" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_details"/>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/travel_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" app:trackCornerRadius="3dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/travel_dist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="0.9 km"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_travelled"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/travel_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="50 km/h"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_speed"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/travel_eta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/glass_ink" android:textSize="17sp" android:textStyle="bold" tools:text="4:10"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/glass_ink_dim" android:textSize="11sp" android:text="@string/route_arrival"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/travel_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="@color/glass_ink_dim" android:textSize="13sp" android:visibility="gone" tools:text="A  Srinivasa Nagar\nB  Chaitanya Nagar"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/route_stop" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:icon="@drawable/ic_stop" android:text="@string/stop_route"/>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <include
        android:id="@+id/screen_saved"
        layout="@layout/tab_saved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav"
        android:visibility="gone" />

    <include
        android:id="@+id/screen_targets"
        layout="@layout/tab_targets"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav"
        android:visibility="gone" />

</RelativeLayout>
