<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SpeedStepper" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GlassFab" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/glass_ink</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Bottom nav: accent pill behind the selected icon; colours from the glass_* / bar_bg tokens -->
    <style name="TacticalBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/bar_bg</item>
        <item name="itemIconTint">@color/nav_icon</item>
        <item name="itemTextColor">@color/nav_label</item>
        <item name="itemActiveIndicatorStyle">@style/TacticalNavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="TacticalNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <style name="GPSSetterOverflowMenu" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/background_menu</item>
    </style>


</resources>